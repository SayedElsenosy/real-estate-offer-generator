generator client {
  provider = "prisma-client"
  // Cloudflare Workers forbid runtime WASM compilation. Generate a
  // Cloudflare-targeted client with a statically importable query compiler.
  runtime  = "cloudflare"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(6)
  image         String?
  role          String    @default("SALES")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  accounts      Account[]
  sessions      Session[]
  offers        Offer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)
  @@id([identifier, token])
}

model Project {
  id           String   @id
  name         String
  slug         String   @unique
  spreadsheetId String?
  sheetRange   String   @default("Inventory!A:Z")
  companyName  String   @default("Real Estate Development")
  logoUrl      String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
  paymentPlans PaymentPlan[]
  floorPlans   FloorPlan[]
  offers       Offer[]
}

model FloorPlan {
  id        String   @id @default(cuid())
  projectId String
  name      String
  floor     String?
  viewBox   String   @default("0 0 1000 700")
  shapes         Json     @default("[]")
  markers        Json     @default("[]")
  backgroundData String?  @db.Text
  reviewStatus   String   @default("DRAFT")
  sourceFileSha256 String? @db.VarChar(64)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model PaymentPlan {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  downPaymentPct    Decimal  @db.Decimal(7, 4)
  months            Int
  maintenancePct    Decimal  @default(0) @db.Decimal(7, 4)
  startOffsetMonths Int      @default(1)
  installmentIntervalMonths Int @default(1)
  deliveryDate      String?  @db.VarChar(10) // legacy; retained for existing records
  deliveryMonths    Int? // expected delivery offset from offer date
  deliveryCollectionEnabled Boolean @default(false)
  deliveryCollectionPct Decimal @default(0) @db.Decimal(7, 4)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @db.Timestamptz(6)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model Offer {
  id                String   @id @default(cuid())
  projectId         String
  userId            String
  unitCode          String
  unitSnapshot      Json
  planSnapshots     Json
  scheduleSnapshots Json
  issuedAt          DateTime @default(now()) @db.Timestamptz(6)
  currency          String   @default("EGP")
  status            String   @default("ISSUED")
  user              User     @relation(fields: [userId], references: [id])
  project           Project  @relation(fields: [projectId], references: [id])
  @@index([userId, issuedAt])
}
